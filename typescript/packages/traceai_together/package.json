{
  "name": "@traceai/together",
  "version": "0.1.0",
  "description": "TraceAI instrumentation for Together AI",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "test": "jest --config jest.config.js",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_together"
  },
  "keywords": [
    "traceai",
    "together",
    "together-ai",
    "opentelemetry",
    "instrumentation",
    "tracing",
    "llm",
    "observability"
  ],
  "author": "FutureAGI",
  "license": "Apache-2.0",
  "dependencies": {
    "@opentelemetry/api": "^1.4.0",
